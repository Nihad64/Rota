<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="center_vertical">
 <LinearLayout android:id="@+id/widget_row_body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:orientation="vertical">
  <TextView android:id="@+id/widget_row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="16sp" android:textColor="#FFFFFF"/>
  <TextView android:id="@+id/widget_row_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#A2A6AD"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_row_done" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="✓" android:textSize="22sp" android:textColor="#FF803F"/>
</LinearLayout>
